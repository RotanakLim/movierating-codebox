# Copy to .env.local. Never commit .env.local or real credentials.
# Supabase Dashboard -> Project Settings -> API / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin. Set to your HTTPS deployment origin on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google client ID/secret belong in Supabase's Google provider settings,
# not in this application.
# Optional, server-only: set to true to show "Continue with Google" once the
# Google provider is set up in Supabase. Leave empty to hide it.
GOOGLE_AUTH_ENABLED=

# Server-only: TMDB API Read Access Token (not the shorter v3 API key).
TMDB_API_READ_ACCESS_TOKEN=

# Server-only: trusted movie cache writes and persistent request limits.
# Never prefix this with NEXT_PUBLIC_. Apply all Supabase migrations first.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: HMAC key for anonymised rate-limit counters. At least 32 random
# bytes; generate with `openssl rand -hex 32`. Must differ from every other key.
RATE_LIMIT_SECRET=

# Server-only: Vercel Cron sends this as a bearer token to
# /api/cron/account-deletions, which retries unfinished account-deletion cleanup.
# At least 32 random characters; generate with `openssl rand -hex 32`.
CRON_SECRET=
